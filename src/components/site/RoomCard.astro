---
import type { RoomType } from '@/lib/database.types';
import type { Lang } from '@/lib/i18n';
import { useTranslations } from '@/lib/i18n';
import { fromPrice, formatIDR } from '@/lib/format';

interface Props {
  room: RoomType;
  lang: Lang;
}
const { room, lang } = Astro.props;
const t = useTranslations(lang);
const q = lang === 'en' ? '?lang=en' : '';

const name = lang === 'id' ? (room.name_id ?? room.name) : room.name;
const desc = lang === 'id' ? (room.description_id ?? room.description) : room.description;
const cover = room.images?.[0];
const price = fromPrice(room);
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all hover:-translate-y-0.5 hover:shadow-lg"
>
  <a href={`/rooms/${room.slug}${q}`} class:list={["relative block aspect-[4/3] overflow-hidden bg-muted", cover && "animate-pulse"]} aria-label={`View ${name}`}>
    {
      cover ? (
        <img
          src={cover}
          alt={name}
          loading="lazy"
          decoding="async"
          width="600"
          height="450"
          onload="this.classList.remove('opacity-0'); this.parentElement?.classList.remove('animate-pulse');"
          class="size-full object-cover opacity-0 transition-[opacity,transform] duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex size-full items-center justify-center font-display text-4xl text-muted-foreground/40">木</div>
      )
    }
    {
      room.featured && (
        <span class="absolute left-3 top-3 rounded-full bg-accent px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-accent-foreground">
          {t('rooms.featured')}
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg font-semibold leading-tight">{name}</h3>
    </div>

    <div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
      {room.size_sqm && <span>{room.size_sqm} {t('rooms.sqm')}</span>}
      <span class="size-1 rounded-full bg-border"></span>
      <span>{room.max_occupancy} {t('rooms.guests')}</span>
      {room.bed_config && (<><span class="size-1 rounded-full bg-border"></span><span>{room.bed_config}</span></>)}
    </div>

    {desc && <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{desc}</p>}

    <div class="mt-auto flex items-end justify-between pt-5">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-muted-foreground">{t('rooms.from')}</span>
        <div class="font-display text-xl font-semibold text-foreground">
          {formatIDR(price)}<span class="text-xs font-normal text-muted-foreground">{t('rooms.night')}</span>
        </div>
      </div>
      <a
        href={`/rooms/${room.slug}${q}`}
        class="inline-flex items-center rounded-md border border-border px-3.5 py-2 text-sm font-medium transition-colors hover:bg-secondary"
      >
        {t('rooms.view')}
      </a>
    </div>
  </div>
</article>
