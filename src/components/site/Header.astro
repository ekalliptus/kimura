---
import { getLangFromUrl, useTranslations, altLangHref } from '@/lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const q = lang === 'en' ? '?lang=en' : '';

const links = [
  { href: `/rooms${q}`, label: t('nav.rooms') },
  { href: `/#packages`, label: t('nav.packages') },
  { href: `/#location`, label: t('nav.location') },
  { href: `/#contact`, label: t('nav.contact') },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href={`/${q}`} class="group flex items-center gap-2.5">
      <span
        class="flex size-9 items-center justify-center rounded-md bg-primary font-display text-lg font-bold text-primary-foreground"
        >木</span
      >
      <span class="flex flex-col leading-none">
        <span class="font-display text-base font-semibold tracking-tight">Kimura</span>
        <span class="text-[10px] uppercase tracking-[0.25em] text-muted-foreground">Kostay</span>
      </span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <!-- Language toggle -->
      <a
        href={altLangHref(Astro.url, lang)}
        class="rounded-md px-2 py-1 text-xs font-medium uppercase tracking-wider text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
        aria-label="Switch language"
      >
        {lang === 'id' ? 'EN' : 'ID'}
      </a>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground"
        aria-label="Toggle theme"
      >
        <svg class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>

      <a
        href={`/book${q}`}
        class="ml-1 inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-foreground shadow-sm transition-all hover:opacity-90"
      >
        {t('nav.book')}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
