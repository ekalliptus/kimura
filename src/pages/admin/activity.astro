---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ConsoleLog from '@/components/admin/ConsoleLog.tsx';
import { adminClient } from '@/lib/admin';
import { adminLang, t as tr } from '@/lib/admin-i18n';
import type { ActivityLog } from '@/lib/database.types';

const lang = adminLang(Astro.cookies.get('admin_lang')?.value);
const supabase = adminClient(Astro);
const { data } = await supabase
  .from('activity_logs')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(100);
const logs = (data ?? []) as ActivityLog[];
---

<AdminLayout title={tr(lang, 'nav.activity')} active="activity" lang={lang}>
  <p class="mb-4 text-sm text-muted-foreground">{tr(lang, 'act.intro')}</p>
  <ConsoleLog initialLogs={logs} lang={lang} client:load />
</AdminLayout>
