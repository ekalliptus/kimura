---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ConsoleLog from '@/components/admin/ConsoleLog.tsx';
import KeepAlivePanel from '@/components/admin/KeepAlivePanel.tsx';
import { adminClient } from '@/lib/admin';
import { formatDateTime } from '@/lib/format';
import { adminLang, t as tr } from '@/lib/admin-i18n';
import type { ActivityLog, KeepAlive } from '@/lib/database.types';

const lang = adminLang(Astro.cookies.get('admin_lang')?.value);
const supabase = adminClient(Astro);
const [kaRes, logsRes, countsRes] = await Promise.all([
  supabase.from('keep_alive').select('*').eq('id', 1).maybeSingle(),
  supabase.from('activity_logs').select('*').eq('category', 'system').order('created_at', { ascending: false }).limit(80),
  supabase.from('bookings').select('id', { count: 'exact', head: true }),
]);

const keepAlive = (kaRes.data ?? null) as KeepAlive | null;
const systemLogs = (logsRes.data ?? []) as ActivityLog[];
const bookingCount = countsRes.count ?? 0;
const user = Astro.locals.user;
const cron = '17 7 * * 1,4';
---

<AdminLayout title={tr(lang, 'nav.system')} active="system" lang={lang}>
  <div class="grid gap-6 lg:grid-cols-2">
    <KeepAlivePanel initial={keepAlive} lang={lang} client:load />

    <!-- Environment / build info -->
    <div class="rounded-xl border border-border bg-card p-6">
      <h2 class="font-display text-lg font-semibold">{tr(lang, 'sys.env')}</h2>
      <dl class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between"><dt class="text-muted-foreground">{tr(lang, 'sys.signed_in')}</dt><dd class="font-medium">{user?.email}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{tr(lang, 'sys.runtime')}</dt><dd class="font-medium">Cloudflare Workers</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{tr(lang, 'sys.cron')}</dt><dd class="font-mono text-xs">{cron}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{tr(lang, 'sys.total_bookings')}</dt><dd class="font-medium">{bookingCount}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">{tr(lang, 'sys.last_ka')}</dt><dd class="font-medium">{keepAlive?.pinged_at ? formatDateTime(keepAlive.pinged_at) : '—'}</dd></div>
      </dl>
    </div>
  </div>

  <div class="mt-6">
    <h2 class="mb-3 font-display text-lg font-semibold">{tr(lang, 'sys.console')}</h2>
    <ConsoleLog initialLogs={systemLogs} lang={lang} client:load />
  </div>
</AdminLayout>
