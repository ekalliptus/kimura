---
import AdminLayout from '@/layouts/AdminLayout.astro';
import ConsoleLog from '@/components/admin/ConsoleLog.tsx';
import KeepAlivePanel from '@/components/admin/KeepAlivePanel.tsx';
import { adminClient } from '@/lib/admin';
import { formatDateTime } from '@/lib/format';
import type { ActivityLog, KeepAlive } from '@/lib/database.types';

const supabase = adminClient(Astro);
const [kaRes, logsRes, countsRes] = await Promise.all([
  supabase.from('keep_alive').select('*').eq('id', 1).maybeSingle(),
  supabase.from('activity_logs').select('*').eq('category', 'system').order('created_at', { ascending: false }).limit(80),
  supabase.from('bookings').select('id', { count: 'exact', head: true }),
]);

const keepAlive = (kaRes.data ?? null) as KeepAlive | null;
const systemLogs = (logsRes.data ?? []) as ActivityLog[];
const bookingCount = countsRes.count ?? 0;
const user = Astro.locals.user;
const cron = '17 7 * * 1,4';
---

<AdminLayout title="System" active="system">
  <div class="grid gap-6 lg:grid-cols-2">
    <KeepAlivePanel initial={keepAlive} client:load />

    <!-- Environment / build info -->
    <div class="rounded-xl border border-border bg-card p-6">
      <h2 class="font-display text-lg font-semibold">Environment</h2>
      <dl class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between"><dt class="text-muted-foreground">Signed in as</dt><dd class="font-medium">{user?.email}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">Runtime</dt><dd class="font-medium">Cloudflare Workers</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">Keep-alive cron</dt><dd class="font-mono text-xs">{cron}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">Total bookings</dt><dd class="font-medium">{bookingCount}</dd></div>
        <div class="flex justify-between"><dt class="text-muted-foreground">Last keep-alive</dt><dd class="font-medium">{keepAlive?.pinged_at ? formatDateTime(keepAlive.pinged_at) : '—'}</dd></div>
      </dl>
    </div>
  </div>

  <div class="mt-6">
    <h2 class="mb-3 font-display text-lg font-semibold">System Console</h2>
    <ConsoleLog initialLogs={systemLogs} client:load />
  </div>
</AdminLayout>
