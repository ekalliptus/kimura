---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { adminClient } from '@/lib/admin';
import { formatIDR, formatDateTime, STATUS_LABELS } from '@/lib/format';
import type { Booking } from '@/lib/database.types';

const supabase = adminClient(Astro);

// Pull data in parallel.
const [bookingsRes, keepAliveRes, logsRes] = await Promise.all([
  supabase.from('bookings').select('*').order('created_at', { ascending: false }).limit(500),
  supabase.from('keep_alive').select('*').eq('id', 1).maybeSingle(),
  supabase.from('activity_logs').select('*').order('created_at', { ascending: false }).limit(6),
]);

const bookings = (bookingsRes.data ?? []) as Booking[];
const keepAlive = keepAliveRes.data;
const recentLogs = logsRes.data ?? [];

const pending = bookings.filter((b) => b.status === 'pending');
const checkedIn = bookings.filter((b) => b.status === 'checked_in');
const today = new Date().toISOString().slice(0, 10);
const arrivalsToday = bookings.filter((b) => b.check_in === today && ['confirmed', 'pending'].includes(b.status));

// Revenue from non-cancelled bookings.
const revenue = bookings
  .filter((b) => !['cancelled', 'no_show'].includes(b.status))
  .reduce((sum, b) => sum + (b.total_price ?? 0), 0);

const recent = bookings.slice(0, 8);

const stats = [
  { label: 'Pending', value: pending.length, hint: 'awaiting confirmation', accent: true },
  { label: 'Checked in', value: checkedIn.length, hint: 'currently staying' },
  { label: 'Arrivals today', value: arrivalsToday.length, hint: today },
  { label: 'Total bookings', value: bookings.length, hint: 'all time' },
];

// Keep-alive freshness (green if pinged within ~4 days).
const lastPing = keepAlive?.pinged_at ? new Date(keepAlive.pinged_at) : null;
const daysSincePing = lastPing ? (Date.now() - lastPing.getTime()) / 86_400_000 : null;
const pingHealthy = daysSincePing != null && daysSincePing < 4;
---

<AdminLayout title="Dashboard" active="dashboard">
  <!-- Stats -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((s) => (
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="text-xs uppercase tracking-wider text-muted-foreground">{s.label}</div>
        <div class:list={['mt-2 font-display text-3xl font-bold', s.accent && s.value > 0 ? 'text-accent' : '']}>{s.value}</div>
        <div class="mt-1 text-xs text-muted-foreground">{s.hint}</div>
      </div>
    ))}
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- Recent bookings -->
    <div class="lg:col-span-2">
      <div class="rounded-xl border border-border bg-card">
        <div class="flex items-center justify-between border-b border-border px-5 py-4">
          <h2 class="font-display font-semibold">Recent bookings</h2>
          <a href="/admin/bookings" class="text-sm text-accent hover:underline">View all →</a>
        </div>
        {recent.length > 0 ? (
          <div class="divide-y divide-border">
            {recent.map((b) => {
              const s = STATUS_LABELS[b.status];
              return (
                <a href={`/admin/bookings?ref=${b.reference}`} class="flex items-center justify-between gap-4 px-5 py-3.5 transition-colors hover:bg-secondary/40">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-xs text-muted-foreground">{b.reference}</span>
                      <span class:list={['rounded-full px-2 py-0.5 text-[10px] font-medium', s?.color]}>{s?.en}</span>
                    </div>
                    <div class="mt-0.5 truncate text-sm font-medium">{b.guest_name}</div>
                  </div>
                  <div class="text-right">
                    <div class="text-sm font-medium">{formatIDR(b.total_price)}</div>
                    <div class="text-xs text-muted-foreground">{b.check_in}</div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="px-5 py-10 text-center text-sm text-muted-foreground">No bookings yet.</p>
        )}
      </div>
    </div>

    <!-- Side column -->
    <div class="space-y-6">
      <!-- Revenue -->
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="text-xs uppercase tracking-wider text-muted-foreground">Booked value</div>
        <div class="mt-2 font-display text-2xl font-bold">{formatIDR(revenue)}</div>
        <div class="mt-1 text-xs text-muted-foreground">excl. cancelled / no-show</div>
      </div>

      <!-- Keep-alive status -->
      <div class="rounded-xl border border-border bg-card p-5">
        <div class="flex items-center justify-between">
          <div class="text-xs uppercase tracking-wider text-muted-foreground">Supabase keep-alive</div>
          <span class:list={['flex size-2.5 rounded-full', pingHealthy ? 'bg-green-500' : 'bg-amber-500']}></span>
        </div>
        <div class="mt-2 text-sm font-medium">{pingHealthy ? 'Healthy' : (lastPing ? 'Stale — check cron' : 'No ping yet')}</div>
        <div class="mt-1 text-xs text-muted-foreground">
          {lastPing ? `Last: ${formatDateTime(keepAlive!.pinged_at)}` : 'Cron has not run.'}
        </div>
        {keepAlive && <div class="mt-1 text-xs text-muted-foreground">{keepAlive.ping_count} pings total</div>}
        <a href="/admin/system" class="mt-3 inline-block text-xs text-accent hover:underline">System details →</a>
      </div>

      <!-- Recent activity -->
      <div class="rounded-xl border border-border bg-card">
        <div class="border-b border-border px-5 py-4"><h2 class="font-display font-semibold">Activity</h2></div>
        {recentLogs.length > 0 ? (
          <ul class="divide-y divide-border">
            {recentLogs.map((l) => (
              <li class="px-5 py-3">
                <div class="text-sm">{l.message}</div>
                <div class="mt-0.5 text-xs text-muted-foreground">{formatDateTime(l.created_at)} · {l.actor}</div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="px-5 py-8 text-center text-sm text-muted-foreground">No activity.</p>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
