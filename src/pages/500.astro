---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import { getLangFromUrl } from '@/lib/i18n';

const lang = getLangFromUrl(Astro.url);
const q = lang === 'en' ? '?lang=en' : '';

const content = {
  id: {
    title: '500 · Gangguan',
    heading: 'Gangguan.',
    subheading: 'Terjadi kesalahan sistem.',
    desc: 'Keseimbangan aliran informasi terganggu sejenak. Kami sedang memulihkan keselarasan sistem.',
    cta: 'Kembali Beranda',
  },
  en: {
    title: '500 · Interruption',
    heading: 'Interruption.',
    subheading: 'A system error occurred.',
    desc: 'The flow of information has been temporarily disrupted. We are restoring the system’s balance.',
    cta: 'Return Home',
  },
};

const page = content[lang];
---

<BaseLayout title={page.title}>
  <Header />

  <main class="relative flex min-h-[65vh] flex-col items-center justify-center overflow-hidden px-5 py-24 text-center">
    <!-- Faded sumi ink Kanji character for "Obstacle/Disturbance" (障) in the background -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center select-none opacity-[0.03] dark:opacity-[0.02]">
      <span class="font-display text-[26rem] sm:text-[32rem] leading-none font-bold">障</span>
    </div>

    <div class="relative z-10 flex flex-col items-center max-w-md">
      <span class="font-display text-xs uppercase tracking-[0.25em] text-accent mb-4">500 Error</span>

      <h1 class="font-display text-5xl font-semibold tracking-tight text-foreground sm:text-6xl md:text-7xl">
        {page.heading}
      </h1>

      <p class="mt-3 font-display text-lg italic text-muted-foreground">
        {page.subheading}
      </p>

      <!-- Minimalist separator line -->
      <div class="my-8 h-px w-12 bg-border"></div>

      <p class="text-sm leading-relaxed text-muted-foreground/80 max-w-sm">
        {page.desc}
      </p>

      <div class="mt-10">
        <a
          href={`/${q}`}
          class="inline-flex items-center justify-center rounded-md border border-primary bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground transition-all hover:opacity-90"
        >
          {page.cta}
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
