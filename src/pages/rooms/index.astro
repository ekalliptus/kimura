---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import RoomCard from '@/components/site/RoomCard.astro';
import { getLangFromUrl, useTranslations } from '@/lib/i18n';
import { getRoomTypes } from '@/lib/queries';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const rooms = await getRoomTypes();
---

<BaseLayout title={t('rooms.title')}>
  <Header />
  <main class="mx-auto max-w-6xl px-5 py-16">
    <div class="max-w-2xl">
      <span class="rule-jp">{t('nav.rooms')}</span>
      <h1 class="mt-4 font-display text-4xl font-bold sm:text-5xl">{t('rooms.title')}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{t('rooms.subtitle')}</p>
    </div>

    {
      rooms.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rooms.map((room) => <RoomCard room={room} lang={lang} />)}
        </div>
      ) : (
        <div class="mt-12 rounded-xl border border-dashed border-border p-12 text-center text-muted-foreground">
          {lang === 'id'
            ? 'Belum ada kamar. Jalankan migrasi & seed database.'
            : 'No rooms yet. Run the DB migrations & seed.'}
        </div>
      )
    }
  </main>
  <Footer />
</BaseLayout>
