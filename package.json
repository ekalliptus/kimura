{
  "name": "kimura",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @kimura/web dev",
    "dev:admin": "bun run --filter @kimura/admin dev",
    "build": "bun run --filter '*' build",
    "build:web": "bun run --filter @kimura/web build",
    "build:admin": "bun run --filter @kimura/admin build",
    "check": "bun run --filter '*' check"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
