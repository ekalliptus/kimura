---
import { getLangFromUrl, useTranslations, altLangHref } from '@kimura/core/i18n';
import { getSiteSettings } from '@/lib/settings';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const q = lang === 'en' ? '?lang=en' : '';
const site = await getSiteSettings();
const [brandMain, ...brandRest] = site.name.split(' ');

const links = [
  { href: `/rooms${q}`, label: t('nav.rooms') },
  { href: `/${q}#packages`, label: t('nav.packages') },
  { href: `/${q}#location`, label: t('nav.location') },
  { href: `/${q}#contact`, label: t('nav.contact') },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href={`/${q}`} class="group flex items-center gap-2.5 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">
      <span
        class="flex size-9 items-center justify-center rounded-md bg-primary font-display text-lg font-bold text-primary-foreground"
        >木</span
      >
      <span class="flex flex-col leading-none">
        <span class="font-display text-base font-semibold tracking-tight">{brandMain}</span>
        {brandRest.length > 0 && (
          <span class="text-[10px] uppercase tracking-[0.25em] text-muted-foreground">{brandRest.join(' ')}</span>
        )}
      </span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-sm text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <!-- Language toggle -->
      <a
        href={altLangHref(Astro.url, lang)}
        class="rounded-md px-2 py-1 text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-label="Switch language"
      >
        {lang === 'id' ? 'EN' : 'ID'}
      </a>

      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        aria-label="Toggle theme"
      >
        <svg class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>

      <a
        href={`/book${q}`}
        class="ml-1 hidden items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-foreground shadow-sm transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:inline-flex"
      >
        {t('nav.book')}
      </a>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="flex size-9 items-center justify-center rounded-md text-foreground transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-open-icon" class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="menu-close-icon" class="hidden size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-border/60 bg-background/95 backdrop-blur-md md:hidden">
    <div class="space-y-1 px-5 py-4">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="block rounded-md px-3 py-2.5 text-base font-medium text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={`/book${q}`}
        class="mt-2 block rounded-md bg-accent px-3 py-2.5 text-center text-base font-medium text-accent-foreground transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset"
      >
        {t('nav.book')}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  menuBtn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });
  // Close menu when a link is tapped (anchor nav)
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }),
  );
</script>
