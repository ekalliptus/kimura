---
import type { RoomType } from '@kimura/core/database.types';
import type { Lang } from '@kimura/core/i18n';
import { useTranslations } from '@kimura/core/i18n';
import { fromPrice, formatIDR } from '@kimura/core/format';
import { getRoomAvailability } from '@/lib/queries';
import { cdnImage, cdnSrcset } from '@kimura/core/img';

interface Props {
  room: RoomType;
  lang: Lang;
}
const { room, lang } = Astro.props;
const t = useTranslations(lang);
const q = lang === 'en' ? '?lang=en' : '';

const name = lang === 'id' ? (room.name_id ?? room.name) : room.name;
const desc = lang === 'id' ? (room.description_id ?? room.description) : room.description;
const coverSrc = room.images?.[0];
const cover = coverSrc ? cdnImage(coverSrc, 640) : undefined;
// Cards render ~1 col (full-width ≤640) → 3 cols (~400px) depending on viewport.
const coverSrcset = coverSrc ? cdnSrcset(coverSrc, [320, 480, 640], 80) : undefined;
const price = fromPrice(room);

// Fetch availability tonight (Jakarta UTC+7)
const d = new Date();
const jakartaTime = new Date(d.getTime() + 7 * 60 * 60 * 1000);
const checkIn = jakartaTime.toISOString().slice(0, 10);
const tomorrow = new Date(jakartaTime.getTime() + 24 * 60 * 60 * 1000);
const checkOut = tomorrow.toISOString().slice(0, 10);

const avail = await getRoomAvailability(room.slug, checkIn, checkOut);
const available = avail?.available ?? 0;
const hasAvailability = avail !== null;

const showFullyBooked = hasAvailability && available <= 0;
const showOnlyOneLeft = hasAvailability && available > 0 && available <= 1;
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-all hover:-translate-y-0.5 hover:shadow-lg"
>
  <a href={`/rooms/${room.slug}${q}`} class:list={["relative block aspect-4/3 overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset", cover && "animate-pulse"]} aria-label={`View ${name}`}>
    {
      cover ? (
        <img
          src={cover}
          srcset={coverSrcset}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          alt={name}
          loading="lazy"
          decoding="async"
          width="600"
          height="450"
          data-reveal
          class="size-full object-cover opacity-0 transition-[opacity,transform] duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex size-full items-center justify-center font-display text-4xl text-muted-foreground/40">木</div>
      )
    }
    {
      room.featured && (
        <span class="absolute left-3 top-3 rounded-full bg-accent px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-accent-foreground">
          {t('rooms.featured')}
        </span>
      )
    }
    {
      showFullyBooked && (
        <span class="absolute right-3 top-3 rounded-full bg-sumi-800 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-sumi-50 border border-sumi-700/50 backdrop-blur-xs">
          {lang === 'id' ? 'Penuh' : 'Fully Booked'}
        </span>
      )
    }
    {
      showOnlyOneLeft && (
        <span class="absolute right-3 top-3 rounded-full bg-indigo-ink px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-clay-100 border border-clay-500/30 backdrop-blur-xs">
          {lang === 'id' ? 'Sisa 1 kamar' : 'Only 1 left'}
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg font-semibold leading-tight">{name}</h3>
    </div>

    <div class="mt-1.5 flex items-center gap-3 text-xs tabular-nums text-muted-foreground">
      {room.size_sqm && <span>{room.size_sqm} {t('rooms.sqm')}</span>}
      <span class="size-1 rounded-full bg-border"></span>
      <span>{room.max_occupancy} {t('rooms.guests')}</span>
      {room.bed_config && (<><span class="size-1 rounded-full bg-border"></span><span>{room.bed_config}</span></>)}
    </div>

    {desc && <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{desc}</p>}

    <div class="mt-auto flex items-end justify-between pt-5">
      <div>
        <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">{t('rooms.from')}</span>
        <div class="font-display text-xl font-semibold tabular-nums text-foreground">
          {formatIDR(price)}<span class="ml-1 align-middle text-[11px] font-normal uppercase tracking-[0.15em] text-muted-foreground">{t('rooms.night')}</span>
        </div>
      </div>
      <a
        href={`/rooms/${room.slug}${q}`}
        aria-label={`View ${name}`}
        class="group/cta inline-flex items-center gap-1.5 rounded-sm text-sm font-medium text-muted-foreground transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-card"
      >
        {t('rooms.view')}
        <span aria-hidden="true" class="text-base transition-transform duration-300 group-hover/cta:translate-x-1">→</span>
      </a>
    </div>
  </div>
</article>
