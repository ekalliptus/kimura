---
import { getLangFromUrl, useTranslations } from '@kimura/core/i18n';
import { tagline } from '@kimura/core/property';
import { getSiteSettings } from '@/lib/settings';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const site = await getSiteSettings();
---

<footer class="border-t border-border/60 bg-secondary/30">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <span class="flex size-9 items-center justify-center rounded-md bg-primary font-display text-lg font-bold text-primary-foreground">木</span>
          <span class="font-display text-lg font-semibold">{site.name}</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground">
          {tagline(site, lang)}
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">{t('nav.contact')}</h4>
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          <li><a href={`tel:${site.phone}`} class="rounded-sm tabular-nums transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="rounded-sm transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">{site.email}</a></li>
          {site.whatsapp && (
            <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="rounded-sm transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">WhatsApp</a></li>
          )}
          <li class="pt-1 tabular-nums">{t('contact.checkin')}: {site.check_in_time} · {t('contact.checkout')}: {site.check_out_time}</li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">{t('nav.location')}</h4>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{site.address}</p>
        <a href={site.maps_url} target="_blank" rel="noopener" aria-label={`${t('location.directions')}${lang === 'id' ? ' (buka di tab baru)' : ' (opens in a new tab)'}`} class="group mt-3 inline-flex items-center gap-1.5 rounded-sm text-sm text-accent transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">{t('location.directions')}<span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span></a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground sm:flex-row">
      <p>© {year} {site.name}. {t('footer.rights')}</p>
      <a href="https://admin.kimura.ekalliptus.com" rel="noopener" class="rounded-sm transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background">Admin</a>
    </div>
  </div>
</footer>
