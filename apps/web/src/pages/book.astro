---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import BookingForm from '@/components/BookingForm.tsx';
import { getLangFromUrl, useTranslations } from '@kimura/core/i18n';
import { getRoomTypes } from '@/lib/queries';
import { getEnv } from '@/lib/env';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const rooms = await getRoomTypes();
const initialRoom = Astro.url.searchParams.get('room') ?? undefined;
const initialPackage = Astro.url.searchParams.get('package') ?? undefined;
const paymentsEnabled = !!getEnv().MIDTRANS_SERVER_KEY;
---

<BaseLayout title={t('book.title')}>
  <Header />
  <main class="mx-auto max-w-5xl px-5 py-16">
    <div class="max-w-2xl">
      <span class="rule-jp">{t('nav.book')}</span>
      <h1 class="mt-4 font-display text-4xl font-bold sm:text-5xl">{t('book.title')}</h1>
      <p class="mt-3 text-lg text-muted-foreground">{t('book.subtitle')}</p>
    </div>

    <div class="mt-12">
      {
        rooms.length > 0 ? (
          <BookingForm rooms={rooms} lang={lang} initialRoom={initialRoom} initialPackage={initialPackage} paymentsEnabled={paymentsEnabled} client:load />
        ) : (
          <div class="rounded-xl border border-dashed border-border p-12 text-center text-muted-foreground">
            {lang === 'id' ? 'Reservasi sedang tidak tersedia. Hubungi kami via WhatsApp di bagian bawah halaman.' : 'Booking is temporarily unavailable. Reach us on WhatsApp in the footer.'}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
